{
  "expo": {
    "name": "Calibrate",
    "slug": "calibrate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "calibrate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calibrate.app",
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
