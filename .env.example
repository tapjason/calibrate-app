# Copy this file to .env.local and fill in the values.
# Vars prefixed with EXPO_PUBLIC_ are bundled into the client at build time.
# The anon key is safe to expose — security comes from Supabase Row Level
# Security policies, not from secret-keeping.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — the iOS client ID from Google Cloud Console.
# Web client ID goes into Supabase dashboard, not here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK keys (Project settings -> API keys -> "public app key").
# Safe to bundle: they authorize reads and purchases for one app, and receipt
# validation happens on RevenueCat's servers. Leave blank and the app runs on
# the free tier with the paywall in its unavailable state.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
