# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (generated by EAS / prebuild)
ios/
android/

# Metro
.metro-health-check*

# Environment — ignore every env file; commit .env.example only
.env
.env.*
!.env.example

# Claude Code per-developer settings
.claude/settings.local.json

# Misc
*.log
.DS_Store

# Supabase CLI local state (project ref, pooler URL, CLI version cache)
supabase/.temp/

# Local screenshot drafts and Playwright MCP output (not for the repo)
screenshots/
.playwright-mcp/

# Harness scratch: incremental tsc info, the web server's log and PID, the release export
.tooling/

# Apple keys (App Store Connect API, In-App Purchase, Sign in with Apple): never commit
*.p8

# Signing certificates, provisioning profiles and PEM keys: never commit
*.p12
*.mobileprovision
*.pem

# Firebase / Google service configs (carry project keys): never commit
GoogleService-Info.plist
google-services.json
